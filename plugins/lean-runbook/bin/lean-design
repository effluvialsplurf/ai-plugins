#!/usr/bin/env python3
"""Symlink-safe launcher for `lean-design`: runs the bundled script from the plugin tree."""
import runpy
import sys
from pathlib import Path

SCRIPT = Path(__file__).resolve().parents[1] / "skills" / "lean-design/scripts/design_check.py"
sys.argv[0] = str(SCRIPT)
runpy.run_path(str(SCRIPT), run_name="__main__")

{
  "lean-runbook-gate": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./skills/lean-runbook/scripts/runbook.py hook session-start --harness antigravity",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./skills/lean-runbook/scripts/runbook.py hook pre-tool-use --harness antigravity",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./skills/lean-runbook/scripts/runbook.py hook pre-tool-use --harness antigravity",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
